digraph G { rankdir=TB; bgcolor="white"; pad=0.3; nodesep=0.55; ranksep=0.75; splines=true; labelloc=t; fontname="Inter"; fontsize=16; label=<<B>C4 — Nível 2: Diagrama de Containers (nova camada de comunicação em verde)</B>>;
ouvinte [shape=box style="filled,rounded" fillcolor="#08427b" color="#073b6f" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Ouvinte / Artista</B><BR/><FONT POINT-SIZE="9">[Pessoa]</FONT><BR/><BR/><FONT POINT-SIZE="9">Usa o MusicVibe pelo navegador</FONT>>];
subgraph cluster_mv { label=<<B>Sistema MusicVibe</B>> fontname="Inter" fontsize=11 fontcolor="#1168bd" style="dashed,rounded" color="#1168bd" margin=16;
spa [shape=box style="filled,rounded" fillcolor="#438dd5" color="#3c7fc0" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Aplicação Web (SPA)</B><BR/><FONT POINT-SIZE="9">[Vue 3 + Vite + Pinia + Axios]</FONT><BR/><BR/><FONT POINT-SIZE="9">Telas de feed, faixa, upload,<BR/>perfil, curtidas e comentários</FONT>>];
api [shape=box style="filled,rounded" fillcolor="#438dd5" color="#3c7fc0" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>API REST</B><BR/><FONT POINT-SIZE="9">[Node.js + Express + Sequelize]</FONT><BR/><BR/><FONT POINT-SIZE="9">Contextos identity, catalog,<BR/>engagement, discovery (DDD)</FONT>>];
db [shape=cylinder style=filled fillcolor="#438dd5" color="#3c7fc0" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Banco de Dados</B><BR/><FONT POINT-SIZE="9">[MySQL 8]</FONT><BR/><BR/><FONT POINT-SIZE="9">users, tracks, likes, comments,<BR/><B>outbox_events</B>, processed_events</FONT>>];
files [shape=folder style=filled fillcolor="#438dd5" color="#3c7fc0" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Armazenamento de Mídia</B><BR/><FONT POINT-SIZE="9">[Disco local / public/uploads]</FONT><BR/><BR/><FONT POINT-SIZE="9">Áudios, capas e fotos de perfil</FONT>>];
relay [shape=box style="filled,rounded" fillcolor="#2e7d32" color="#1b5e20" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Outbox Relay</B><BR/><FONT POINT-SIZE="9">[Node.js worker]</FONT><BR/><BR/><FONT POINT-SIZE="9">Lê outbox_events e publica<BR/>no broker (at-least-once)</FONT>>];
mq [shape=box3d style=filled fillcolor="#2e7d32" color="#1b5e20" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Broker de Mensagens</B><BR/><FONT POINT-SIZE="9">[RabbitMQ 3.13 (exchange topic)]</FONT><BR/><BR/><FONT POINT-SIZE="9">musicvibe.events + filas<BR/>duráveis + DLQ</FONT>>];
wstats [shape=box style="filled,rounded" fillcolor="#2e7d32" color="#1b5e20" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Worker de Estatísticas</B><BR/><FONT POINT-SIZE="9">[Node.js + amqplib]</FONT><BR/><BR/><FONT POINT-SIZE="9">Atualiza TrackStats<BR/>(curtidas, comentários, plays)</FONT>>];
wnotif [shape=box style="filled,rounded" fillcolor="#2e7d32" color="#1b5e20" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Worker de Notificações</B><BR/><FONT POINT-SIZE="9">[Node.js + amqplib]</FONT><BR/><BR/><FONT POINT-SIZE="9">Notifica artista sobre<BR/>curtidas e comentários</FONT>>];
wmedia [shape=box style="filled,rounded" fillcolor="#2e7d32" color="#1b5e20" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Worker de Mídia</B><BR/><FONT POINT-SIZE="9">[Node.js + ffmpeg]</FONT><BR/><BR/><FONT POINT-SIZE="9">Extrai duração e forma de onda<BR/>após o upload</FONT>>];
}
email [shape=box style="filled,rounded" fillcolor="#999999" color="#8a8a8a" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Serviço de E-mail</B><BR/><FONT POINT-SIZE="9">[SMTP (externo)]</FONT><BR/><BR/><FONT POINT-SIZE="9">Entrega e-mails</FONT>>];
ouvinte -> spa [label=<<FONT POINT-SIZE="9">Usa</FONT><BR/><FONT POINT-SIZE="8">[HTTPS]</FONT>> fontname="Inter" color="#555555" fontcolor="#333333" style=dashed arrowsize=0.7];
spa -> api [label=<<FONT POINT-SIZE="9">Chamadas JSON/REST</FONT><BR/><FONT POINT-SIZE="8">[HTTPS + JWT]</FONT>> fontname="Inter" color="#555555" fontcolor="#333333" style=dashed arrowsize=0.7];
api -> db [label=<<FONT POINT-SIZE="9">Lê/escreve agregado +<BR/>evento na MESMA transação</FONT><BR/><FONT POINT-SIZE="8">[SQL/TCP]</FONT>> fontname="Inter" color="#555555" fontcolor="#333333" style=dashed arrowsize=0.7];
api -> files [label=<<FONT POINT-SIZE="9">Grava/lê arquivos</FONT><BR/><FONT POINT-SIZE="8">[fs]</FONT>> fontname="Inter" color="#555555" fontcolor="#333333" style=dashed arrowsize=0.7];
relay -> db [label=<<FONT POINT-SIZE="9">Lê eventos pendentes</FONT><BR/><FONT POINT-SIZE="8">[SQL]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
relay -> mq [label=<<FONT POINT-SIZE="9">Publica eventos</FONT><BR/><FONT POINT-SIZE="8">[AMQP (confirms)]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
mq -> wstats [label=<<FONT POINT-SIZE="9">Entrega eventos</FONT><BR/><FONT POINT-SIZE="8">[AMQP]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
mq -> wnotif [label=<<FONT POINT-SIZE="9">Entrega eventos</FONT><BR/><FONT POINT-SIZE="8">[AMQP]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
mq -> wmedia [label=<<FONT POINT-SIZE="9">Entrega TrackUploaded</FONT><BR/><FONT POINT-SIZE="8">[AMQP]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
wstats -> db [label=<<FONT POINT-SIZE="9">Atualiza contadores</FONT><BR/><FONT POINT-SIZE="8">[SQL]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
wmedia -> files [label=<<FONT POINT-SIZE="9">Lê áudio</FONT><BR/><FONT POINT-SIZE="8">[fs]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
wnotif -> email [label=<<FONT POINT-SIZE="9">Envia e-mail</FONT><BR/><FONT POINT-SIZE="8">[SMTP]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
}