digraph G { rankdir=TB; bgcolor="white"; pad=0.3; nodesep=0.55; ranksep=0.75; splines=true; labelloc=t; fontname="Inter"; fontsize=16; label=<<B>C4 — Nível 1: Diagrama de Contexto (MusicVibe + mensageria)</B>>;
{rank=same; ouvinte; artista; admin}
ouvinte [shape=box style="filled,rounded" fillcolor="#08427b" color="#073b6f" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Ouvinte / Visitante</B><BR/><FONT POINT-SIZE="9">[Pessoa]</FONT><BR/><BR/><FONT POINT-SIZE="9">Ouve, curte e comenta faixas</FONT>>];
artista [shape=box style="filled,rounded" fillcolor="#08427b" color="#073b6f" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Artista</B><BR/><FONT POINT-SIZE="9">[Pessoa]</FONT><BR/><BR/><FONT POINT-SIZE="9">Publica, edita e exclui faixas</FONT>>];
admin [shape=box style="filled,rounded" fillcolor="#08427b" color="#073b6f" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Administrador</B><BR/><FONT POINT-SIZE="9">[Pessoa]</FONT><BR/><BR/><FONT POINT-SIZE="9">Gerencia usuários, gêneros e conteúdo</FONT>>];
mv [shape=box style="filled,rounded" fillcolor="#1168bd" color="#0b4884" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>MusicVibe</B><BR/><FONT POINT-SIZE="9">[Sistema de software]</FONT><BR/><BR/><FONT POINT-SIZE="9">Plataforma web de streaming e<BR/>divulgação de música autoral</FONT>>];
broker [shape=box style="filled,rounded" fillcolor="#2e7d32" color="#1b5e20" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Serviço de Mensageria</B><BR/><FONT POINT-SIZE="9">[RabbitMQ (novo)]</FONT><BR/><BR/><FONT POINT-SIZE="9">Barramento de eventos entre<BR/>módulos e sistemas</FONT>>];
email [shape=box style="filled,rounded" fillcolor="#999999" color="#8a8a8a" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Serviço de E-mail</B><BR/><FONT POINT-SIZE="9">[SMTP / SendGrid (externo)]</FONT><BR/><BR/><FONT POINT-SIZE="9">Envia notificações por e-mail</FONT>>];
bi [shape=box style="filled,rounded" fillcolor="#999999" color="#8a8a8a" fontcolor="white" fontname="Inter" fontsize=12 margin="0.18,0.1" width=2.4 label=<<B>Analytics / BI</B><BR/><FONT POINT-SIZE="9">[Sistema externo]</FONT><BR/><BR/><FONT POINT-SIZE="9">Relatórios de audiência para<BR/>artistas e administração</FONT>>];
ouvinte -> mv [label=<<FONT POINT-SIZE="9">Ouve, curte, comenta</FONT><BR/><FONT POINT-SIZE="8">[HTTPS]</FONT>> fontname="Inter" color="#555555" fontcolor="#333333" style=dashed arrowsize=0.7];
artista -> mv [label=<<FONT POINT-SIZE="9">Envia e gerencia faixas</FONT><BR/><FONT POINT-SIZE="8">[HTTPS]</FONT>> fontname="Inter" color="#555555" fontcolor="#333333" style=dashed arrowsize=0.7];
admin -> mv [label=<<FONT POINT-SIZE="9">Administra</FONT><BR/><FONT POINT-SIZE="8">[HTTPS]</FONT>> fontname="Inter" color="#555555" fontcolor="#333333" style=dashed arrowsize=0.7];
mv -> broker [label=<<FONT POINT-SIZE="9">Publica e consome eventos de domínio</FONT><BR/><FONT POINT-SIZE="8">[AMQP 0-9-1]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
broker -> email [label=<<FONT POINT-SIZE="9">Notificações (via worker)</FONT><BR/><FONT POINT-SIZE="8">[AMQP / HTTPS]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
broker -> bi [label=<<FONT POINT-SIZE="9">Eventos de reprodução/curtida</FONT><BR/><FONT POINT-SIZE="8">[AMQP]</FONT>> fontname="Inter" color="#2e7d32" fontcolor="#333333" style=dashed arrowsize=0.7];
}